
// Time: O(n), Space: O(n)
function longestSubarrayWithSumK(nums, k) {
  const prefixIndex = new Map();
  let prefixSum = 0;
  let maxLen = 0;

  // prefix sum 0 is seen at index -1
  prefixIndex.set(0, -1);

  for (let i = 0; i < nums.length; i++) {
    prefixSum += nums[i];

    // we want prefixSum - k to have appeared before
    const needed = prefixSum - k;
    if (prefixIndex.has(needed)) {
      const prevIndex = prefixIndex.get(needed);
      const len = i - prevIndex;
      if (len > maxLen) {
        maxLen = len;
      }
    }

    // store first occurrence of this prefix sum
    if (!prefixIndex.has(prefixSum)) {
      prefixIndex.set(prefixSum, i);
    }
  }

  return maxLen;
}

// Simple tests
function test() {
  console.log(longestSubarrayWithSumK([1, 2, 3, 1, 1, 1, 2, 3], 6));          // 3
  console.log(longestSubarrayWithSumK([2, -1, 2, 3, -2, 4], 4));             // 5
  console.log(longestSubarrayWithSumK([1, 1, 1], 5));                       // 0
  console.log(longestSubarrayWithSumK([3, 4, 7, -2, 2, 1, 4, 2], 7));      // 4
}

test();





    Example 1 : 
Input: nums = [1, 2, 3, 1, 1, 1, 2, 3], k = 6
Output: 4
Explanation: One longest subarray is [1, 2, 3] (sum = 6, length = 3) and another is [1, 1, 1, 2, 1] (hypothetical). Longest possible length is 4.

    Example 2 : 
Input: nums = [2, -1, 2, 3, -2, 4], k = 4
Output: 5
Explanation: Longest subarray [2, -1, 2, 3, -2] has sum 4 and length 5.

