/**
 * @param {number[]} nums
 * @return {number}
 */
var majorityElement = function(nums) {
    let count = 0;
    let candidate = null;

    // Boyer-Moore Voting Algorithm
    for (let num of nums) {
        if (count === 0) {
            candidate = num;
        }
        
        // If the current number matches the candidate, increment count. 
        // Otherwise, decrement count.
        count += (num === candidate) ? 1 : -1;
    }

    return candidate;
};
